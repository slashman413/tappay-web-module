{
  "name": "tappay-web-module",
  "version": "1.1.0",
  "description": "A well-structured, zero-dependency, themeable web module that wraps the TapPay TPDirect SDK to enable 18 payment methods (Direct Pay, Google Pay, Apple Pay, Samsung Pay, LINE Pay, JKO Pay, and regional Asian wallets) with a drop-in dark/light checkout UI or low-level adapters.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./style.css": "./src/ui/checkout.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npx -y serve .",
    "example": "npx -y serve examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashman413/tappay-web-module.git"
  },
  "keywords": [
    "tappay",
    "tpdirect",
    "payment",
    "google-pay",
    "apple-pay",
    "samsung-pay",
    "line-pay",
    "jko-pay",
    "easy-wallet",
    "pi-wallet",
    "direct-pay",
    "credit-card",
    "bnpl",
    "aftee",
    "checkout",
    "sdk",
    "modal",
    "dark-mode",
    "taiwan"
  ],
  "author": "slashman413",
  "license": "MIT",
  "homepage": "https://github.com/slashman413/tappay-web-module#readme",
  "bugs": {
    "url": "https://github.com/slashman413/tappay-web-module/issues"
  }
}
